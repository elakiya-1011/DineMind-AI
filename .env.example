# DineMind AI Environment Variables Template

# OpenAI API Key (or OpenRouter API Key starting with sk-or-v1-)
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here

# Optional OpenRouter Base URL override (automatically detected if using sk-or-)
# OPENAI_API_BASE=https://openrouter.ai/api/v1

# LLM Model Name (e.g. gpt-4o-mini or openai/gpt-4o-mini for OpenRouter)
LLM_MODEL_NAME=openai/gpt-4o-mini

# Embedding Model Name
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Admin Dashboard Password
ADMIN_PASSWORD=admin123
